# Copiar para .env.local em desenvolvimento e cadastrar na hospedagem em produção.
# Estas variáveis são lidas somente no servidor. Nunca usar o prefixo VITE_ nelas:
# o prefixo VITE_ embute o valor no JavaScript público.

# --- Obrigatórias para o formulário enviar. Sem elas, o endpoint responde 503. ---

# Chave da API do Resend (https://resend.com).
RESEND_API_KEY=
# Remetente, em um domínio verificado no Resend. Ex.: Site Crédito e Fomento <site@dominio.com.br>
CONTACT_EMAIL_FROM=
# Caixa da equipe comercial que recebe as solicitações.
CONTACT_EMAIL_TO=

# --- Necessárias em produção para o limite de envios valer entre instâncias. ---
# Sem elas, o limite é em memória, por instância, o que não protege em hospedagem serverless.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Opcionais ---

# Origens adicionais autorizadas, separadas por vírgula. A origem do próprio site já é aceita.
CONTACT_ALLOWED_ORIGINS=
# Altera o endereço da API de e-mail. Usado nos testes; em produção, deixar em branco.
RESEND_API_URL=
